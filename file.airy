set sum 0
set count 0

infloop true
{
    read n

    if n == 0
    {
        break
    }

    if n > 0
    {
        assign sum sum + n
        assign count count + 1
    }
}

show count
show sum

if count > 0
{
    set average sum / count
    show average
}
else
{
    show "No positive numbers entered"
}