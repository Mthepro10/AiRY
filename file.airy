Set sum = 0
Set count = 0

Repeat forever

Read number

If number == 0 Then
    Break
EndIf

If number > 0 Then
    sum = sum + number
    count = count + 1
EndIf

EndRepeat

Show "Count:"
Show count

Show "Sum:"
Show sum

If count > 0 Then
average = sum / count

Show "Average:"
Show average

Else
Show "No positive numbers entered"
EndIf